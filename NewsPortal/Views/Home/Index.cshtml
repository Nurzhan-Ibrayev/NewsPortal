@model PublicArticleListViewModel
@{
    ViewData["Title"] = "Новости";
}

<h1 class="h3 mb-4">Новости</h1>

@if (Model.Articles.Count == 0)
{
    <p class="text-muted">Опубликованных новостей пока нет.</p>
}

@foreach (var article in Model.Articles)
{
    <article class="card mb-3">
        <div class="card-body">
            <h2 class="h5 card-title">
                <a asp-action="Article" asp-route-id="@article.Id" class="text-decoration-none">@article.Title</a>
            </h2>
            <p class="card-subtitle text-muted small mb-2">
                @article.Author?.DisplayName · <partial name="_DateTime" model="article.PublishedAt" />
            </p>
            <p class="card-text article-content">@article.GetExcerpt()</p>
            <a asp-action="Article" asp-route-id="@article.Id" class="card-link">Читать полностью</a>
        </div>
    </article>
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Страницы">
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)">Назад</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">@Model.Page из @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)">Вперёд</a>
            </li>
        </ul>
    </nav>
}
